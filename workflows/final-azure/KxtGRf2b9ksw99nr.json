      "id": "39e59b69-6095-46ab-8f49-74e17aa14a5c",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidates AS (\n    SELECT t.ticket_id, t.department, t.department || ' Team' AS recipient_group,\n        CASE\n            WHEN t.due_at > NOW() AND t.due_at <= NOW() + INTERVAL '15 minutes' THEN 'SLA warning: ticket ' || t.ticket_id || ' is due within 15 minutes.'\n            WHEN t.due_at <= NOW() THEN 'SLA due: ticket ' || t.ticket_id || ' has reached its deadline and is still active.'\n        END AS message\n    FROM tickets t\n    WHERE t.status IN ('Open', 'In Progress')\n      AND ((t.due_at > NOW() AND t.due_at <= NOW() + INTERVAL '15 minutes') OR t.due_at <= NOW())\n), inserted AS (\n    INSERT INTO notifications (ticket_id, department, recipient_group, message, channel, status)\n    SELECT c.ticket_id, c.department, c.recipient_group, c.message, 'email', 'sent'\n    FROM candidates c\n    WHERE NOT EXISTS (\n        SELECT 1 FROM notifications n\n        WHERE n.ticket_id = c.ticket_id AND n.message = c.message AND n.channel = 'email'\n    )\n    RETURNING ticket_id, department, recipient_group, message, channel, status\n)\nSELECT i.*, t.title, t.priority, t.due_at, t.status AS ticket_status\nFROM inserted i\nJOIN tickets t ON t.ticket_id = i.ticket_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "ca2b37ee-c3e1-4df5-80cb-4e94ab4ab6c3",
