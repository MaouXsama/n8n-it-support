          "query": "INSERT INTO tickets (\n  ticket_id, title, description, requester, department, priority, sla_hours,\n  status, classification_status, classification_keyword, created_at, due_at\n) VALUES (\n  '{{ $json.ticket_id }}',\n  '{{ $json.title }}',\n  '{{ $json.description }}',\n  '{{ $json.requester }}',\n  '{{ $json.department }}',\n  '{{ $json.priority }}',\n  {{ $json.sla_hours }},\n  '{{ $json.status }}',\n  '{{ $json.classification_status }}',\n  '{{ $json.classification_keyword }}',\n  '{{ $json.created_at }}',\n  '{{ $json.due_at }}'\n)\nRETURNING *;",
