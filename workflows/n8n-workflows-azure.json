  {
    "updatedAt": "2026-09-24T22:32:09.149Z",
    "createdAt": "2026-09-24T22:25:36.829Z",
    "id": "KxtGRf2b9ksw99nr",
    "name": "02 - SLA Reminder Check",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 1
              }
            ]
          }
        },
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.4,
        "position": [
          0,
          0
        ],
        "id": "39e59b69-6095-46ab-8f49-74e17aa14a5c",
        "name": "Schedule Trigger"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO notifications (\n    ticket_id,\n    department,\n    recipient_group,\n    message,\n    channel,\n    status\n)\nSELECT\n    t.ticket_id,\n    t.department,\n    t.department || ' Team',\n    'SLA warning: ticket ' || t.ticket_id ||\n    ' is due within 15 minutes.',\n    'mock',\n    'sent'\nFROM tickets t\nWHERE t.status IN ('Open', 'In Progress')\n  AND t.due_at > NOW()\n  AND t.due_at <= NOW() + INTERVAL '15 minutes'\n  AND NOT EXISTS (\n      SELECT 1\n      FROM notifications n\n      WHERE n.ticket_id = t.ticket_id\n        AND n.message LIKE 'SLA warning:%'\n  )\n\nUNION ALL\n\nSELECT\n    t.ticket_id,\n    t.department,\n    t.department || ' Team',\n    'SLA due: ticket ' || t.ticket_id ||\n    ' has reached its deadline and is still active.',\n    'mock',\n    'sent'\nFROM tickets t\nWHERE t.status IN ('Open', 'In Progress')\n  AND t.due_at <= NOW()\n  AND NOT EXISTS (\n      SELECT 1\n      FROM notifications n\n      WHERE n.ticket_id = t.ticket_id\n        AND n.message LIKE 'SLA due:%'\n  );",
          "options": {}
        },
