      {
        "parameters": {
          "jsCode": "const department = $json.department;\n\nconst recipientGroups = {\n  Networking: 'Networking Team',\n  'IT Helpdesk': 'IT Helpdesk Team',\n  Software: 'Software Team'\n};\n\nreturn {\n  json: {\n    ...$json,\n    notification_ticket_id: $json.ticket_id,\n    notification_department: department,\n    recipient_group: recipientGroups[department] || 'IT Helpdesk Team',\n    notification_message:\n      `New ${department} ticket: ${$json.title}. ` +\n      `SLA: ${$json.sla_hours} hours.`\n  }\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          896,
